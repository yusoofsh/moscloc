{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "moscloc",
	"compatibility_date": "2026-05-20",
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"head_sampling_rate": 1,
			"persist": true,
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
		},
	},
	"assets": {
		"directory": "dist",
	},
	"compatibility_flags": ["nodejs_compat"],
}
